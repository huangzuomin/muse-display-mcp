# /etc/muse-display/env 模板 — 复制后填真实值；文件权限必须 0600（需求 §13）
# 这些值永不入仓库、永不出现在命令行或日志

# MCP token（评审 T1：未设置服务拒绝启动）。生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MUSE_DISPLAY_TOKEN=change-me

# MQTT 凭据（HoloCubic 链路；与 /etc/mosquitto/passwd 一致）
MQTT_USERNAME=muse
MQTT_PASSWORD=change-me

# 可选：设备注册表路径（默认 ./config/devices.yaml，WorkingDirectory=/opt/muse-display）
#MUSE_DISPLAY_CONFIG=/opt/muse-display/config/devices.yaml

# 可选：传输（默认 stdio；systemd 常驻必须 http）
MUSE_DISPLAY_TRANSPORT=http
MUSE_DISPLAY_HTTP_HOST=0.0.0.0
MUSE_DISPLAY_HTTP_PORT=8080
